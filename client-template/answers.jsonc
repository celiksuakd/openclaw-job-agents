// Standard answers the Applier types into application forms. It never invents an answer:
// if a required question isn't covered here or in the job's answers.md, the job goes to "needs you".
{
  "identity": {
    "first_name": "REPLACE",
    "last_name": "REPLACE",
    "preferred_name": "",
    "email": "REPLACE@example.com",
    "phone": "",                          // e.g. "+90 555 123 45 67"
    "city": "",
    "country": "",
    "linkedin": "",                       // full URL
    "github": "",
    "portfolio": "",
    "pronouns": ""                       // leave empty to skip optional pronoun fields
  },

  "work_authorization": {
    // Be exact; wrong answers here can void an offer. One line per country/region, e.g.
    //   "Türkiye": "Citizen, no sponsorship needed",  "European Union": "Requires sponsorship"
    "default": "REPLACE"
  },
  "willing_to_relocate": "",            // e.g. "Yes, within the EU" / "No"
  "remote_preference": "",
  "notice_period": "",                  // e.g. "1 month"
  "earliest_start_date": "",

  "salary": {
    "currency": "",                     // e.g. "EUR", "TRY", "USD"
    "minimum_annual": null,
    "target_annual": null,
    "answer_text": "",                  // e.g. "My expectation is in the €50–60k range, depending on the full package."
    "share_when_optional": false         // leave optional salary fields blank
  },

  "years_experience": { "total": null }, // add per-skill years only if true, e.g. "sql": 4
  "highest_education": "",              // e.g. "BSc Industrial Engineering, Boğaziçi University, 2021"
  "languages": {},                     // e.g. { "Turkish": "Native", "English": "Professional (C1)" }

  "how_did_you_hear": "Company careers page",
  "previously_worked_here": "",          // varies per company; leave empty so the client is asked
  "has_relatives_at_company": "",
  "background_check_ok": "",
  "over_18": "Yes",

  // Voluntary self-identification (EEO / diversity) questions.
  "eeo": {
    "gender": "Decline to self-identify",
    "race_ethnicity": "Decline to self-identify",
    "veteran_status": "I don't wish to answer",
    "disability": "I don't wish to answer"
  },

  // Consent the client gave at onboarding. The Applier may tick required data-processing
  // consent boxes needed to apply. Marketing / talent-community opt-ins stay unticked.
  "consent": {
    "data_processing_to_apply": true,
    "talent_pool_retention": false,
    "marketing": false
  }
}
